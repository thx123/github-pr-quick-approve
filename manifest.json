{
  "manifest_version": 3,
  "name": "GitHub PR Quick Approve",
  "version": "1.1.0",
  "description": "Approve GitHub PRs with a configurable keyboard shortcut",
  "permissions": ["storage"],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*/pull/*"],
      "js": ["content.js"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
